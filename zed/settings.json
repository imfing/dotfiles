// Zed settings
{
  // UI
  "agent_servers": {},
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "git": {
    "path_style": "file_name_first"
  },
  "edit_predictions": {
    "provider": "none"
  },
  "ui_font_family": ".ZedSans",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "buffer_font_family": "Berkeley Mono",
  "theme": {
    "mode": "light",
    "dark": "Vesper",
    "light": "macOS Classic Light"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "terminal": {
    "copy_on_select": true,
    "font_family": "BerkeleyMono Nerd Font Mono",
    "font_size": 13
  },
  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "sort_by_path": true
  },
  "formatter": "language_server",
  "base_keymap": "VSCode",
  "format_on_save": "on",
  "agent": {
    "dock": "left",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "!basedpyright",
        "ruff"
      ],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  }
}
